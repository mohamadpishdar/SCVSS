Add an investor-callable cancel for unresolved orders after maturity. It pays only the order's owner, so it
cannot be abused. Resolve is already blocked after maturity, so the two paths cannot overlap.
function cancelOrder(string calldata actionId) external nonReentrant {
    Order storage order = orders[actionId];
    if (order.token == address(0)) revert InvalidOrder();
    if (order.resolved) revert OrderAlreadyResolved();
    if (order.user != msg.sender) revert NotOrderOwner();
    (, , , uint256 maturityDate) = IToken(order.token).getAmountsAndDate();
    if (block.timestamp <= maturityDate + CANCEL_GRACE) revert OfferingNotEnded();

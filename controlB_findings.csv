    ctx.address(""l1GatewayProxy""), 
  ]); 
  const supply = await readFinalized<bigint>(ctx, ""l2"", ctx.address(""l2Token""), 
tokenAbi, ""totalSupply""); 
  return check(""L1 escrow >= L2 supply"", true, escrow >= supply); 
} 

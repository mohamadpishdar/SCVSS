struct BridgeStorage {
mapping(address asset => AssetStatus status) balanceAssets;
mapping(address asset => AssetStatus status) spotAssets;
mapping(address asset => bool) everSupported;
mapping(address asset => uint64 nonce) balanceWithdrawNonces;
mapping(address asset => uint64 nonce) spotWithdrawNonces;
mapping(address asset => uint64 nonce) balanceDepositNonces;
mapping(address asset => uint64 nonce) spotDepositNonces;

    ScrollChainMiscData memory cachedMiscData = miscData; 
    if (cachedMiscData.lastCommittedBatchIndex != 
cachedMiscData.lastFinalizedBatchIndex) { 
        revert ErrorMigrateUnfinalizedBatches(); 
    } 
    if (_decodeBoolFromFlag(cachedMiscData.flags, ENFORCED_MODE_OFFSET)) revert 
ErrorMigrateInEnforcedBatchMode(); 
    if (!_decodeBoolFromFlag(cachedMiscData.flags, V1_MESSAGES_FINALIZED_OFFSET)) { 
        revert ErrorMigrateV1MessagesNotFinalized(); 
    } 
    if ( 
        IL1MessageQueueV2(messageQueueV2).nextUnfinalizedQueueIndex() != 

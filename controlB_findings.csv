2
uint256 amount = pendingBurn;
3
if (amount == 0) {
4
return;
5
}
6
address sink = buyAndBurnAddress;
7
if (sink == address(0)) {
8
revert InvalidAddress();
9
}
10
pendingBurn = 0;
11
// @audit-issue Sending funds to a sink address does not reduce the token total supply.
12
(bool burned, ) = sink.call{value: amount}("""");
13
if (!burned) {
14
revert TransferFailed();
15
}
16
emit BuyAndBurnExecuted(sink, amount);
17
}
18
Recommendation(s): Consider revisiting the burn logic to ensure that the accrued tokens are sent to the zero address or properly
removed from circulation.
Status: Fixed
Update from the client: Fixed. sink was removed and the address(0) is used to burn.
Update from Nethermind: fixed at commit.

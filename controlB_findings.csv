Round up in _convertToExitShares() using _divRoundUp():
function _convertToExitShares(uint256 assets_, uint256 totalAssets_) internal view
returns (uint256 shares_) {
,→
uint256 exitAssets_
= totalAssets_ - _unrealizedLosses(totalAssets_);
uint256 totalShares_ = totalShares;
if (totalShares_ == 0) return assets_;
shares_ = _divRoundUp(assets_ * totalShares_, exitAssets_);

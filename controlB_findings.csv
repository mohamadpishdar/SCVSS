(, int24 spotTick,,,,,) = pool.slot0();
assertEq(uint32(block.timestamp) - lastTimestamp, 2 hours);
int24 meanTick = PoolTwap.checkDeviationAndMeanTick(address(pool));
assertEq(meanTick, spotTick);
